# Monday's keys: copy this file to .env (same folder) and paste each key you have after its = sign.
# .env is in .gitignore: it never leaves this computer. Monday never shows a key back, never sends one to a page or the phone,
# and never writes one anywhere but .env (Settings → Integrations writes here too). Real environment variables win over .env.

# Jev (TypeSafe System One): Monday's first decision layer. Without it every request uses Monday's own rules.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=

# Other chat AIs ("Monday, use Claude / ChatGPT / Gemini / Grok / DeepSeek / Mistral"): only the ones you have.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Voices: Google's text-to-speech, Fish Audio (your cloned voice), and Google's speech recognizer for the ear.
GOOGLE_TTS_API_KEY=
FISH_AUDIO_API_KEY=
MONDAY_GOOGLE_SPEECH_KEY=

# Research: Cloudflare's browsers.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Google (your own OAuth client, for Calendar, Gmail and Drive).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The phone companion across networks (ngrok).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# Computer use: the cua-driver Hermes drives the screen with (a path, not a secret). Leave empty to keep Hermes off the desktop.
MONDAY_CUA_DRIVER=
